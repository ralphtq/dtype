# baseURI: http://www.linkedmodel.org/2.1/schema/dtype
# imports: http://www.linkedmodel.org/schema/vaem

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dtype: <http://www.linkedmodel.org/schema/dtype#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/voag#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:author
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "author" ;
  rdfs:range xsd:string ;
.
<http://www.linkedmodel.org/2.1/schema/dtype>
  a owl:Ontology ;
  dcterms:author "Ralph Hodgson" ;
  dcterms:subject "Datatype Schema" ;
  dcterms:title "Datatype Ontology" ;
  vaem:hasGraphMetadata dtype:GMD_DTYPE ;
  rdfs:label "Datatype Ontology" ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  owl:versionIRI <http://www.linkedmodel.org/2.1/schema/dtype> ;
.
dtype:CodeList
  a owl:Class ;
  dcterms:description "A codelist is a controlled vocabulary of terms that are used to represent permissible values of a variable in information systems. The representaiton of codes in \"dtype\" has been influenced by CCTS and UBL." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "Codelist" ;
  rdfs:subClassOf dtype:Enumeration ;
.
dtype:CompositeCodeList
  a owl:Class ;
  dcterms:description "A composite codelist is a codelist made up of other codelists. It does not introduce any new codes." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "Composite Code List" ;
  rdfs:subClassOf dtype:CodeList ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom dtype:CodeList ;
      owl:onProperty dtype:compositeOf ;
    ] ;
  owl:disjointWith dtype:DerivedCodeList ;
  owl:disjointWith dtype:SimpleCodeList ;
.
dtype:DerivedCodeList
  a owl:Class ;
  dcterms:description "A derived codelist is a sublist of another codelist. The members that it has must be members of the source list." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "Derived Code List" ;
  rdfs:subClassOf dtype:CodeList ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom dtype:CodeList ;
      owl:onProperty dtype:derivedFrom ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom dtype:ValueReference ;
      owl:onProperty dtype:hasMember ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality 1 ;
      owl:onProperty dtype:derivedFrom ;
    ] ;
  owl:disjointWith dtype:CompositeCodeList ;
  owl:disjointWith dtype:SimpleCodeList ;
.
dtype:EnumeratedValue
  a owl:Class ;
  dcterms:description """
The base class for datatypes that have values that are restriced to a set of literals or tokens. 
The members of the restriction may themselves be restriced by facets that apply to scalar data types.
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "DTYPE Enumerated Value" ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality 1 ;
      owl:onProperty dtype:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality 1 ;
      owl:onProperty dtype:code ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality 1 ;
      owl:onProperty dtype:literal ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality 1 ;
      owl:onProperty dtype:order ;
    ] ;
.
dtype:Enumeration
  a owl:Class ;
  dcterms:description """
A type that serves as a container for the enumerated values of an enumeration. 
This enables the enumeration itself to be referenceable. 
One need for this is in determing the default value of an enumeration.
Another need is in the management of sub-enumerations and composite enumerations.
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "DTYPE Enumeration" ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom dtype:EnumeratedValue ;
      owl:onProperty dtype:defaultObjectValue ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom dtype:EnumeratedValue ;
      owl:onProperty dtype:value ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality 1 ;
      owl:onProperty dtype:defaultObjectValue ;
    ] ;
.
dtype:GMD_DTYPE
  a vaem:GraphMetaData ;
  dcterms:created "2011-05-29"^^xsd:date ;
  dcterms:modified "2023-11-14"^^xsd:date ;
  dcterms:title "DTYPE Version 2.1 Metadata" ;
  vaem:description """
The ontology "dtype" provides a specification of simple data types such as enumerations and codelists. 
These are needed in support of the conversion of XML Schemas and UML Models to OWL. 
The purpose of "dtype" is to provide a foundation for expressing rich data types. 
These data types are typically needed when dealing with OWL representations of data structures derived from XML Schema.
""" ;
  vaem:hasGraphRole vaem:SchemaGraph ;
  vaem:hasLicenseType <http://voag.linkedmodel.org/voag/CC-SHAREALIKE_3PT0-US> ;
  vaem:hasOwner vaem:TopQuadrant ;
  vaem:hasSteward vaem:TopQuadrant ;
  vaem:intent "The purpose of DTYPE is to provide, by import, a foundation for  data types." ;
  vaem:latestPublishedVersion "http://www.linkedmodel.org/doc/2023/SCHEMA_dtype-v2.1"^^xsd:anyURI ;
  vaem:logo "http://www.linkedmodel.org/lib/lm/images/logos/dtype_logo-300x110.png"^^xsd:anyURI ;
  vaem:name "DTYPE" ;
  vaem:namespace "http://www.linkedmodel.org/schema/dtype#"^^xsd:anyURI ;
  vaem:namespacePrefix "dtype" ;
  vaem:owner "LinkedModel.org" ;
  vaem:previousPublishedVersion "http://www.linkedmodel.org/doc/2015/SCHEMA_dtype-v1.2"^^xsd:anyURI ;
  vaem:releaseDate "2023-11-14"^^xsd:date ;
  vaem:revision "2.1" ;
  vaem:title "Datatype Schema (DTYPE) - Version 2.1" ;
  vaem:turtleFileURL "http://www.linkedmodel.org/dtype/2.1/schema/SCHEMA_dtype-2.1.ttl"^^xsd:anyURI ;
  vaem:usesNonImportedResource dcterms:abstract ;
  vaem:usesNonImportedResource dcterms:author ;
  vaem:usesNonImportedResource dcterms:created ;
  vaem:usesNonImportedResource dcterms:modified ;
  vaem:usesNonImportedResource dcterms:title ;
  vaem:usesNonImportedResource <http://voag.linkedmodel.org/voag/CC-SHAREALIKE_3PT0-US> ;
  vaem:withAttributionTo "DTYPE is issued under a Creative Commons Attribution Share Alike 3.0 United States License." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "DTYPE Schema Version 2.1 Metadata" ;
.
dtype:SimpleCodeList
  a owl:Class ;
  dcterms:description "A simple codelist is one made up only of enumerated values." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "Simple Code List" ;
  rdfs:subClassOf dtype:CodeList ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom dtype:EnumeratedValue ;
      owl:onProperty dtype:hasMember ;
    ] ;
  owl:disjointWith dtype:CompositeCodeList ;
  owl:disjointWith dtype:DerivedCodeList ;
.
dtype:ValueReference
  a owl:Class ;
  dcterms:description """
A value reference is a pointer to an Enumerated Value. 
The original order of the value can be overridden by the "order" attribute.
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "Value Reference" ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:allValuesFrom dtype:EnumeratedValue ;
      owl:onProperty dtype:refersTo ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality 1 ;
      owl:onProperty dtype:refersTo ;
    ] ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality 1 ;
      owl:onProperty dtype:order ;
    ] ;
.
dtype:code
  a owl:DatatypeProperty ;
  dcterms:description """
A property for expressing a unique value for a member of an enumeration. 
The range has been set to "xsd:anySimpleType" to allow for any scalar datatype.
""" ;
  rdfs:comment "A unique value that is assigned to an enumeration member." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "code" ;
  rdfs:range xsd:anySimpleType ;
.
dtype:compositeOf
  a owl:ObjectProperty ;
  dcterms:description "A property for constructing composite data structures" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "composite of" ;
.
dtype:dateUnion
  a rdfs:Datatype ;
  dcterms:description "A datatype that is the union of date datatypes." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "date union" ;
  rdfs:subClassOf rdfs:Resource ;
  owl:equivalentClass [
      a owl:Class ;
      owl:unionOf (
          xsd:date
          xsd:dateTime
          xsd:gYear
          xsd:gMonth
          xsd:gMonthDay
          xsd:gYearMonth
          xsd:gDay
        ) ;
    ] ;
.
dtype:defaultValue
  a owl:DatatypeProperty ;
  dcterms:description """
The property "dtype:defaultValue" is a general property for specifying a literal value in situations where 
none is specified.
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "default value" ;
.
dtype:defaultObjectValue
  a owl:ObjectProperty ;
  dcterms:description """
The property "dtype:defaultValue" is a general property for specifying an object value in situations where 
none is specified.
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "default object value" ;
.
dtype:derivedFrom
  a owl:ObjectProperty ;
  dcterms:description "A property for specifying a derivation relationship." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "derived from" ;
.
dtype:hasMember
  a owl:ObjectProperty ;
  dcterms:description "A property for specifying how member elements make up a data structure." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "has member" ;
.
dtype:isInvalid
  a owl:DatatypeProperty ;
  dcterms:description "A boolean flag to state that a value is invalid with respect to its type." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "is invalid" ;
  rdfs:range xsd:boolean ;
.
dtype:literal
  a owl:DatatypeProperty ;
  dcterms:description """
A general purpose property for holding string literals as a machine-readable string for how the 
enumerated value can be referred to. 
This can be used when the code value is numeric, as an alternative to using a code. 
Literal is not the same as label which is intended for human readable display. 
For example, a code for January may be 1, the literal may be 'J' or 'jan' and the label 'January'.
""" ;
  rdfs:comment "" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "literal" ;
  rdfs:range xsd:string ;
.
dtype:numericUnion
  a rdfs:Datatype ;
  dcterms:description """
A datatype that is the union of numeric xsd data types.
"dtype:numericUnion" is equivalent to the xsd specification that uses an xsd:union of 
memberTypes="xsd:decimal xsd:double xsd:float xsd:integer".
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "numeric union" ;
  rdfs:subClassOf rdfs:Resource ;
  owl:equivalentClass [
      a rdfs:Datatype ;
      owl:unionOf (
          xsd:float
          xsd:decimal
          xsd:integer
          xsd:double
        ) ;
    ] ;
.
dtype:order
  a owl:DatatypeProperty ;
  dcterms:description """
The property "dtype:order" provides a means to specify a precedence. 
One use of order is in specifying ordered enumerations such as "voag:ConfidentialityLevel".
A similar property, but with an important type difference, is "vaem:orderIndex".
This is for use on property occurrences in class axioms where it can be placed on a restriction 
to specify how that property may be transformed into other representations where ordering has some 
importance, for example, in XML Schema sequences. 
Whereas "vaem:order" is a datatype property, "vaem:orderIndex" is an annotation property.
The "order" property specifies a value that can establish precedence and ordinality. 
One use of order is in make an enumeration an ordinal type. 
For example "RiskLevel" might have the values "very low", "low", "medium", "high" and "very high".
A query that asks for all risks that are greater than "medium" would use the ordinal values and return 
those resources that have “medium”, “high” and “very high” ordinality.
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "order" ;
  rdfs:range xsd:integer ;
  rdfs:seeAlso dtype:orderIndex ;
.
dtype:orderIndex
  a owl:AnnotationProperty ;
  dcterms:description """
The property "dtype:orderIndex" is an annotation property to specify a position that some value or 
structure will have. 
One use is to specify the place that a resource has in a sequence.
Another use is on property occurrences in class axioms, where "vaem:orderIndex" is placed on a 
restriction to specify how that property may be transformed into a representation where ordering has 
some importance, for example, in XML Schema sequences.
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "order index" ;
  rdfs:range xsd:integer ;
.
dtype:refersTo
  a owl:ObjectProperty ;
  dcterms:description """
An indirection pointer for relating a slot in am occurrence data structure, such as "dtype:ValueReference" with another resource.
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "refers to" ;
.
dtype:type
  a owl:ObjectProperty ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "datatype" ;
.
dtype:value
  a owl:DatatypeProperty ;
  dcterms:description """
The property "dtype:value" is a general property for specifying a literal value in situations where 
none is specified.
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "value" ;
  rdfs:range xsd:anySimpleType ;
.
dtype:objectValue
  a owl:ObjectProperty ;
  dcterms:description """
The property "dtype:objectValue" is a general property for specifying an object value in situations where 
none is specified.
""" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.1/schema/dtype> ;
  rdfs:label "object value" ;
.
